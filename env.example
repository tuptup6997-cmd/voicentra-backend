# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub or share it publicly.

# ---- Server ----
PORT=3000

# Comma-separated list of website domains allowed to submit to this API.
# Use "*" while testing locally, then lock it down before going live.
ALLOWED_ORIGINS=*

# ---- Where submissions get delivered ----
TO_EMAIL=info@voicentraresearch.com
CC_EMAIL=voicentraresearch@gmail.com

# ---- SMTP (the relay service that actually SENDS the email) ----
# Example values below are for Brevo (free, no Gmail app-password hassle).
# See README for Gmail or other providers instead.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login (shown on the Brevo SMTP & API page)
SMTP_PASS=your-brevo-smtp-key

# The address people will see as the sender in their inbox.
# With Brevo, this must be an email you've verified under
# Senders, Domains & Dedicated IPs -> Senders in your Brevo account.
# If left blank, it falls back to SMTP_USER (fine for Gmail setups).
FROM_EMAIL=voicentraresearch@gmail.com
