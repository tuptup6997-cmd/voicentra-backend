# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub or share it publicly.

# ---- Server ----
PORT=3000

# Comma-separated list of website domains allowed to submit to this API.
# Use "*" while testing locally, then lock it down before going live.
ALLOWED_ORIGINS=*

# ---- Where submissions get delivered ----
TO_EMAIL=info@voicentraresearch.com
CC_EMAIL=voicentraresearch@gmail.com

# ---- Email sending (Brevo HTTP API) ----
# IMPORTANT: Render's free plan blocks SMTP ports (25/465/587) entirely,
# so this uses Brevo's HTTPS API instead of SMTP — get this key from your
# Brevo dashboard -> profile icon -> "SMTP & API" -> "API Keys & MCP" tab
# -> "Generate a new API key". This is a DIFFERENT key from the SMTP key.
BREVO_API_KEY=your-brevo-api-key

# The address and name people will see as the sender in their inbox.
# This email must be a "Verified" sender in your Brevo account, under
# Senders, Domains & Dedicated IPs -> Senders.
FROM_EMAIL=voicentraresearch@gmail.com
FROM_NAME=Voicentra Website
